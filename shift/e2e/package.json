{
  "name": "@shift-stack/e2e",
  "description": "SHiFT in a real browser: a small fixture app, built for production, and Playwright tests against it.",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": "./src/*"
  },
  "scripts": {
    "build": "vite build && vite build --ssr src/server/main.ts --outDir dist/server",
    "start": "node dist/server/main.js",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@effect/platform": "^0.97.2",
    "@effect/platform-node": "^0.108.2",
    "effect": "^3.22.2",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@shift-stack/core": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte-check": "^4.7.6",
    "vite": "^8.3.1"
  }
}
